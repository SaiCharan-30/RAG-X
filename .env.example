# Application
APP_NAME=RAG-X API

# PostgreSQL (matches docker-compose.yml; the copy uses host port 5433)
# If Windows Smart App Control blocks psycopg, use postgresql+pg8000:// instead.
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/rag_x

# Qdrant (matches docker-compose.yml; the copy uses host port 6335)
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=rag_x_documents

# Gemini (get a key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# true  = fake LLM answers (for wiring tests, no API key needed)
# false = real Gemini calls
MOCK_LLM=true
