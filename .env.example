# Application
APP_NAME=RAG-X API

# true prints every SQL statement (very noisy). Keep false for normal use and demos.
DEBUG=false

# PostgreSQL (matches docker-compose.yml; host port 5433)
# pg8000 is pure Python, so Windows Smart App Control does not block it.
DATABASE_URL=postgresql+pg8000://rag_user:rag_password@localhost:5433/rag_x

# Qdrant (matches docker-compose.yml; host port 6335)
QDRANT_URL=http://localhost:6335
QDRANT_COLLECTION=rag_x_documents

# Gemini (get a key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# true  = fake LLM answers (for wiring tests, no API key needed)
# false = real Gemini calls
MOCK_LLM=true